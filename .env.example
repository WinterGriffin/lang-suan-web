# Public Supabase project URL. Used by the browser only after authentication work begins.
NEXT_PUBLIC_SUPABASE_URL=
# Public anonymous/publishable key. RLS constrains this key; never use a service-role key in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_PROJECT_REF=local
NEXT_PUBLIC_ENABLE_LINE_LOGIN=true
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false
NEXT_PUBLIC_ENABLE_FACEBOOK_LOGIN=false
NEXT_PUBLIC_ENABLE_APPLE_LOGIN=false

# Browser-facing origin used by server-side auth redirects. For Docker-local
# deployment, keep this as http://localhost:3000; never use 0.0.0.0 here.
APP_URL=http://localhost:3000
LOG_LEVEL=info
ENABLE_DEBUG_TOOLS=true

# Optional server-only URL for a Dockerized Next.js server. With Supabase local
# on Docker Desktop, set this to http://host.docker.internal:54321 while keeping
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 for the browser.
SUPABASE_URL_INTERNAL=

# Server-only Resend key for future application transactional mail. Never prefix NEXT_PUBLIC_.
# Local Supabase Auth continues to deliver confirmation mail to Inbucket.
RESEND_API_KEY=

# Server-only, reserved for trusted maintenance tooling. Do not add its value to an env file committed to Git.
# SUPABASE_SERVICE_ROLE_KEY=
