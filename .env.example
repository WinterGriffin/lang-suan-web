# Public Supabase project URL. Used by the browser only after authentication work begins.
NEXT_PUBLIC_SUPABASE_URL=
# Public anonymous/publishable key. RLS constrains this key; never use a service-role key in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only, reserved for trusted maintenance tooling. Do not add its value to an env file committed to Git.
# SUPABASE_SERVICE_ROLE_KEY=
