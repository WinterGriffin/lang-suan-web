{
  "name": "lang-suan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm exec -- next dev",
    "build": "npm exec -- next build",
    "start": "npm exec -- next start",
    "typecheck": "npm exec -- tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:database-contract": "node --test tests/database-contract.test.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vinext/cloudflare": "^1.0.0-beta.9",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.1",
    "@types/node": "22.15.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "supabase": "^2.117.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.136.1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module"
}
