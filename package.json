{
  "name": "lang-suan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm exec -- next dev",
    "build": "npm exec -- next build",
    "start": "npm exec -- next start",
    "typecheck": "npm exec -- next typegen && npm exec -- tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:database-contract": "node --test tests/database-contract.test.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "validate:local": "node scripts/validate-environment.mjs local",
    "validate:staging": "node scripts/validate-environment.mjs staging",
    "validate:production": "node scripts/validate-environment.mjs production",
    "config:fingerprint:staging": "node scripts/config-fingerprint.mjs staging",
    "config:fingerprint:production": "node scripts/config-fingerprint.mjs production",
    "auth:audit:staging": "node scripts/verify-hosted-auth.mjs staging",
    "auth:audit:production": "node scripts/verify-hosted-auth.mjs production",
    "build:local": "node scripts/run-environment-command.mjs local build",
    "dev:local": "node scripts/run-environment-command.mjs local dev",
    "build:staging": "node scripts/run-environment-command.mjs staging build",
    "build:production": "node scripts/run-environment-command.mjs production build",
    "deploy:staging": "node scripts/run-environment-command.mjs staging deploy",
    "deploy:production": "node scripts/run-environment-command.mjs production deploy",
    "domain:audit:staging": "node scripts/cloudflare-domains.mjs staging audit",
    "domain:apply:staging": "node scripts/cloudflare-domains.mjs staging apply",
    "domain:audit:production": "node scripts/cloudflare-domains.mjs production audit",
    "smoke:staging": "node scripts/smoke-deployment.mjs staging",
    "smoke:production": "node scripts/smoke-deployment.mjs production",
    "smoke:https:staging": "node scripts/smoke-https.mjs staging",
    "smoke:https:production": "node scripts/smoke-https.mjs production"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vinext/cloudflare": "^1.0.0-beta.9",
    "next": "16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.1",
    "@types/node": "22.15.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "supabase": "^2.117.0",
    "typescript": "5.9.3",
    "vite": "^8.3.0",
    "wrangler": "^4.136.1"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
